# Copy to agent/.env and fill in. DO NOT COMMIT .env.

# Anthropic API key — https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-...

# GitHub token with repo + PR permissions (fine-grained PAT is fine)
# Needed so the agent can push its curator/YYYY-MM-DD branch and open the PR
GITHUB_TOKEN=ghp_...
