---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import Footer from '../components/Footer.astro';
import {
  bookChapters,
  craftLibraries,
  openHardwareTools,
  researchTracks,
} from '../data/resources';

const totalReadMinutes = bookChapters.reduce((total, chapter) => total + chapter.minutes, 0);

type TocSection = { anchor: string; text: string };
const sectionAnchors = new Map<object, string>();
const chapterSections = new Map<string, TocSection[]>();

bookChapters.forEach((chapter) => {
  const sections: TocSection[] = [];
  (chapter.blocks ?? []).forEach((block) => {
    if (block.type === 'heading' && block.level === 2) {
      const anchor = `${chapter.id}-sec-${sections.length + 1}`;
      sectionAnchors.set(block, anchor);
      sections.push({ anchor, text: block.text });
    }
  });
  chapterSections.set(chapter.id, sections);
});
const visibleResearchTracks = researchTracks.filter((track) => track.label !== 'Publishing layer');
const panelLabels = {
  vignette: 'The Builder',
  saga: 'Saga',
  sidebar: 'Field Note',
};
---

<Base
  title="Citadel Resources - Building the Future"
  description="A fresh Citadel Resources site with an ebook reader, research map, open hardware, and craft library."
>
  <Header />

  <main>
    <section class="reader-hero" id="reader">
      <div class="reader-bg" aria-hidden="true"></div>
      <div class="container reader-mast">
        <p class="eyebrow">The Guild Reading Room / Draft 0.3</p>
        <h1>Building<br />the Future</h1>
        <p>
          GM. My name is FLX. For now I'm a lone builder, but I believe we can rebuild
          better. We can outbuild centralization and control with freedom, culture, craft,
          honest money, and private tools. I need help. We need to become more. Only a
          critical mass of builders can turn this from a signal into workshops, homes, gardens,
          machines, libraries, and living places. The time is now, because we already have what
          we need: Bitcoin, Nostr, gaming engines, open hardware, cryptography, privacy, and
          the will to build peacefully around the systems that failed us. No coffee, no workee.
        </p>
        <div class="reader-mast__tags" aria-label="Book metadata">
          <span>The Guild Edition</span>
          <span>{bookChapters.length} chapters</span>
          <span>{totalReadMinutes} min</span>
        </div>
      </div>
      <div class="container reader-layout">
        <aside class="reader-toc" aria-label="Book table of contents">
          <p class="eyebrow">Contents / {bookChapters.length}</p>
          <div class="toc-list">
            {
              bookChapters.map((chapter, index) => {
                const sections = chapterSections.get(chapter.id) ?? [];
                const buttonClass = index === 0 ? 'toc-button is-active' : 'toc-button';

                return sections.length > 0 ? (
                  <details class="toc-item" data-toc-item={chapter.id}>
                    <summary class={buttonClass} data-chapter-target={chapter.id}>
                      <span>{chapter.label}</span>
                      <strong>{chapter.title}</strong>
                      <small>{chapter.minutes} min</small>
                    </summary>
                    <div class="toc-sections">
                      {sections.map((section) => (
                        <button
                          type="button"
                          class="toc-section"
                          data-section-jump={section.anchor}
                          data-section-chapter={chapter.id}
                        >
                          {section.text}
                        </button>
                      ))}
                    </div>
                  </details>
                ) : (
                  <button class={buttonClass} type="button" data-chapter-target={chapter.id}>
                    <span>{chapter.label}</span>
                    <strong>{chapter.title}</strong>
                    <small>{chapter.minutes} min</small>
                  </button>
                );
              })
            }
          </div>
        </aside>

        <section class="reader-shell" aria-label="Ebook reader">
          <div class="reader-toolbar">
            <div>
              <p class="eyebrow">Citadel Resources Edition</p>
              <strong>Draft reader</strong>
            </div>
            <label class="reader-jump" aria-label="Chapter navigation">
              <span>Chapter</span>
              <select data-reader-chapter-select>
                {
                  bookChapters.map((chapter) => (
                    <option value={chapter.id}>
                      {chapter.label} - {chapter.title}
                    </option>
                  ))
                }
              </select>
            </label>
            <div class="reader-controls" aria-label="Reader controls">
              <button type="button" data-reader-prev title="Previous chapter">Prev</button>
              <button type="button" data-reader-next title="Next chapter">Next</button>
              <button type="button" data-reader-smaller title="Decrease text size">A-</button>
              <button type="button" data-reader-larger title="Increase text size">A+</button>
              <button type="button" data-reader-tone title="Toggle reader tone">Tone</button>
              <button
                type="button"
                data-reader-fullscreen
                aria-pressed="false"
                title="Toggle fullscreen reader"
              >
                Full
              </button>
              <a
                href="/books/BuildingTheFuture_v0.3_web.pdf"
                target="_blank"
                rel="noopener noreferrer"
                title="Open PDF"
              >
                PDF
              </a>
            </div>
          </div>
          <div class="reader-progress" aria-hidden="true"><span data-reader-progress></span></div>
          <div class="reader-resume" data-reader-resume hidden>
            <button type="button" data-reader-resume-go>
              <span class="mono">// continue reading</span>
              <strong data-reader-resume-label></strong>
            </button>
            <button type="button" data-reader-resume-dismiss aria-label="Dismiss resume banner">
              &times;
            </button>
          </div>
          <div class="reader-window" data-reader>
            {
              bookChapters.map((chapter, index) => (
                <article
                  class={index === 0 ? 'reader-chapter is-active' : 'reader-chapter'}
                  data-reader-chapter={chapter.id}
                >
                  <p class="chapter-label">{chapter.label}</p>
                  <h2>{chapter.title}</h2>
                  <p class="chapter-deck">{chapter.deck}</p>
                  {chapter.epigraph && (
                    <blockquote class="chapter-epigraph">
                      <p>"{chapter.epigraph.text}"</p>
                      <cite>- {chapter.epigraph.by}</cite>
                    </blockquote>
                  )}
                  {chapter.vignette && (
                    <aside class="chapter-vignette">
                      <p class="eyebrow">The Builder</p>
                      <p>{chapter.vignette}</p>
                    </aside>
                  )}
                  {chapter.blocks
                    ? chapter.blocks.map((block) => (
                        <>
                          {block.type === 'heading' && block.level === 2 && (
                            <h3 id={sectionAnchors.get(block)}>{block.text}</h3>
                          )}
                          {block.type === 'heading' && block.level === 3 && <h4>{block.text}</h4>}
                          {block.type === 'paragraph' && <p>{block.text}</p>}
                          {block.type === 'quote' && (
                            <blockquote class="chapter-quote">
                              <p>{block.text}</p>
                            </blockquote>
                          )}
                          {block.type === 'list' && (
                            <ul class="chapter-list">
                              {block.items.map((item) => <li>{item}</li>)}
                            </ul>
                          )}
                          {block.type === 'image' && (
                            <figure class="chapter-image">
                              <img src={block.src} alt={block.caption ?? ''} loading="lazy" />
                              {block.caption && <figcaption>{block.caption}</figcaption>}
                            </figure>
                          )}
                          {block.type === 'panel' && (
                            <aside class={`chapter-panel chapter-panel--${block.variant}`}>
                              <p class="eyebrow">{panelLabels[block.variant]}</p>
                              {block.blocks.map((panelBlock) => (
                                <>
                                  {panelBlock.type === 'heading' && panelBlock.level === 2 && (
                                    <h3>{panelBlock.text}</h3>
                                  )}
                                  {panelBlock.type === 'heading' && panelBlock.level === 3 && (
                                    <h4>{panelBlock.text}</h4>
                                  )}
                                  {panelBlock.type === 'paragraph' && <p>{panelBlock.text}</p>}
                                  {panelBlock.type === 'quote' && (
                                    <blockquote class="chapter-quote">
                                      <p>{panelBlock.text}</p>
                                    </blockquote>
                                  )}
                                  {panelBlock.type === 'list' && (
                                    <ul class="chapter-list">
                                      {panelBlock.items.map((item) => <li>{item}</li>)}
                                    </ul>
                                  )}
                                  {panelBlock.type === 'image' && (
                                    <figure class="chapter-image">
                                      <img
                                        src={panelBlock.src}
                                        alt={panelBlock.caption ?? ''}
                                        loading="lazy"
                                      />
                                      {panelBlock.caption && (
                                        <figcaption>{panelBlock.caption}</figcaption>
                                      )}
                                    </figure>
                                  )}
                                </>
                              ))}
                            </aside>
                          )}
                        </>
                      ))
                    : chapter.sections
                      ? chapter.sections.map((section) => (
                          <section class="chapter-section">
                            {section.heading && <h3>{section.heading}</h3>}
                            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                          </section>
                        ))
                      : chapter.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
                  {chapter.bullets && (
                    <ul class="chapter-list">
                      {chapter.bullets.map((item) => <li>{item}</li>)}
                    </ul>
                  )}
                </article>
              ))
            }
          </div>
        </section>
      </div>
    </section>

    <Section
      id="research"
      num="01"
      title="Research Map"
      desc="Curated source lanes for the book spine, physical systems, and Bitcoin economies."
    >
      <div class="research-grid">
        {
          visibleResearchTracks.map((track) => (
            <article class="research-card">
              <p class="eyebrow">{track.label}</p>
              <h3>{track.title}</h3>
              <p>{track.reason}</p>
              <div class="source-list">
                {track.sources.map((source) => (
                  <a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </Section>

    <Section
      id="hardware"
      num="02"
      title="Open Hardware"
      desc="Open Source Ecology becomes the physical toolkit: machines, build docs, material systems, and outbuilding infrastructure."
    >
      <div class="hardware-terminal">
        <div class="hardware-terminal__intro">
          <p class="eyebrow">OSE integration</p>
          <h3>Blueprints for civilization, filtered for outbuilding.</h3>
          <p>
            Start with the Global Village Construction Set, then pull out the machines that matter
            first for a citadel site: building shell, earth blocks, lumber, fabrication, welding,
            water, power, and repair.
          </p>
          <a href="https://www.opensourceecology.org/" target="_blank" rel="noopener noreferrer">
            Open Source Ecology
          </a>
        </div>
        <div class="hardware-grid">
          {
            openHardwareTools.map((tool, index) => (
              <article class="hardware-card">
                <div class="hardware-card__top">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <span>{tool.stage}</span>
                </div>
                <h3>{tool.title}</h3>
                <p class="hardware-card__category">{tool.category}</p>
                <p>{tool.why}</p>
                <div class="hardware-use">
                  <strong>Outbuilding use</strong>
                  <span>{tool.outbuildingUse}</span>
                </div>
                <a href={tool.sourceUrl} target="_blank" rel="noopener noreferrer">Source docs</a>
              </article>
            ))
          }
        </div>
      </div>
    </Section>

    <Section
      id="craft"
      num="03"
      title="Craft Library"
      desc="Citadel is a home of craft by hand, helped by machines when machines are the right tool."
    >
      <div class="craft-library">
        <div class="craft-library__intro">
          <p class="eyebrow">Hand first</p>
          <h3>Earth, wood, water, heat, shelter, and repair.</h3>
          <p>
            The machine stack is useful only when it strengthens local skill. This library separates
            open wikis, open design systems, free field guides, and FOSS design workflows so each
            guild can build from sources that are traceable.
          </p>
        </div>

        <div class="craft-source-grid">
          {
            craftLibraries.map((source, index) => (
              <article class="craft-source">
                <div class="craft-source__top">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <span>{source.openness}</span>
                </div>
                <h3>{source.title}</h3>
                <p class="craft-source__meta">
                  <span>{source.discipline}</span>
                  <span>{source.mode}</span>
                </p>
                <p>{source.why}</p>
                <div class="craft-source__use">
                  <strong>Guild use</strong>
                  <span>{source.use}</span>
                </div>
                <a href={source.sourceUrl} target="_blank" rel="noopener noreferrer">
                  Open source
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </Section>

    <Footer />
  </main>

  <script>
    const initReader = () => {
      const buttons = Array.from(document.querySelectorAll<HTMLElement>('[data-chapter-target]'));
      const chapters = Array.from(document.querySelectorAll<HTMLElement>('[data-reader-chapter]'));
      const chapterSelect =
        document.querySelector<HTMLSelectElement>('[data-reader-chapter-select]');
      const reader = document.querySelector<HTMLElement>('[data-reader]');
      const progress = document.querySelector<HTMLElement>('[data-reader-progress]');
      const shell = document.querySelector<HTMLElement>('.reader-shell');
      const fullscreenButton =
        document.querySelector<HTMLButtonElement>('[data-reader-fullscreen]');
      let fontScale = 1;

      const syncFullscreenButton = () => {
        const isFullscreen = shell?.classList.contains('is-reader-fullscreen') ?? false;

        document.body.classList.toggle('has-reader-fullscreen', isFullscreen);

        if (!fullscreenButton) return;

        fullscreenButton.textContent = isFullscreen ? 'Exit' : 'Full';
        fullscreenButton.setAttribute('aria-pressed', String(isFullscreen));
      };

      const setReaderFullscreen = (isFullscreen: boolean) => {
        shell?.classList.toggle('is-reader-fullscreen', isFullscreen);
        syncFullscreenButton();
      };

      const tocItems = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-toc-item]'));

      const STORAGE_KEY = 'citadel-reader';

      type ReaderMemory = { lastChapter?: string; scroll?: number; read?: string[] };

      const loadMemory = (): ReaderMemory => {
        try {
          return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
        } catch {
          return {};
        }
      };

      const saveMemory = (patch: ReaderMemory) => {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify({ ...loadMemory(), ...patch }));
        } catch {
          /* storage unavailable (private mode) — reader still works without memory */
        }
      };

      const readChapters = new Set(loadMemory().read || []);

      const markChapterRead = (id: string) => {
        if (!readChapters.has(id)) {
          readChapters.add(id);
          saveMemory({ read: [...readChapters] });
        }
        buttons.forEach((button) => {
          if (button.dataset.chapterTarget === id) {
            button.classList.add('is-read');
          }
        });
      };

      const setChapter = (id = '', options: { scrollTop?: boolean; updateHash?: boolean } = {}) => {
        const { scrollTop = true, updateHash = true } = options;
        const targetId = chapters.some((chapter) => chapter.dataset.readerChapter === id)
          ? id
          : chapters[0]?.dataset.readerChapter || '';

        buttons.forEach((button) => {
          button.classList.toggle('is-active', button.dataset.chapterTarget === targetId);
        });
        chapters.forEach((chapter) => {
          chapter.classList.toggle('is-active', chapter.dataset.readerChapter === targetId);
        });
        tocItems.forEach((item) => {
          item.open = item.dataset.tocItem === targetId;
        });
        if (chapterSelect && chapterSelect.value !== targetId) {
          chapterSelect.value = targetId;
        }
        if (reader && scrollTop) {
          reader.scrollTo({ top: 0, behavior: 'smooth' });
        }
        if (progress) {
          progress.style.transform = 'scaleX(0)';
        }
        if (updateHash) {
          history.replaceState(null, '', `#reader/${targetId}`);
        }
        saveMemory({ lastChapter: targetId, scroll: 0 });
      };

      buttons.forEach((button) => {
        button.addEventListener('click', (event) => {
          const details = button.closest<HTMLDetailsElement>('details.toc-item');

          if (details) {
            // Summaries: control open state manually (accordion behavior).
            event.preventDefault();

            if (details.open && button.classList.contains('is-active')) {
              details.open = false;
              return;
            }
          }

          setChapter(button.dataset.chapterTarget || '');
        });
      });

      // Lazy images above a jump target shift the layout as they load, so keep
      // re-anchoring for a short window after each jump (until the user scrolls).
      let jumpFixup: (() => void) | null = null;
      let jumpFixupExpiry: ReturnType<typeof setTimeout> | undefined;

      document.querySelectorAll<HTMLElement>('[data-section-jump]').forEach((button) => {
        button.addEventListener('click', () => {
          const chapterId = button.dataset.sectionChapter || '';
          const anchor = button.dataset.sectionJump || '';

          setChapter(chapterId, { scrollTop: false, updateHash: false });
          history.replaceState(null, '', `#reader/${chapterId}/${anchor.slice(chapterId.length + 1)}`);

          const target = document.getElementById(anchor);

          if (!reader || !target) return;

          const scrollToTarget = (behavior: ScrollBehavior) => {
            const top =
              target.getBoundingClientRect().top -
              reader.getBoundingClientRect().top +
              reader.scrollTop -
              16;
            reader.scrollTo({ top: Math.max(0, top), behavior });
          };

          scrollToTarget('smooth');

          clearTimeout(jumpFixupExpiry);
          jumpFixup = () => scrollToTarget('auto');
          jumpFixupExpiry = setTimeout(() => {
            jumpFixup = null;
          }, 2500);
        });
      });

      // 'load' does not bubble, so listen in the capture phase.
      reader?.addEventListener('load', () => jumpFixup?.(), true);
      ['wheel', 'touchstart'].forEach((eventName) => {
        reader?.addEventListener(eventName, () => {
          jumpFixup = null;
        }, { passive: true });
      });

      chapterSelect?.addEventListener('change', () => setChapter(chapterSelect.value));

      const stepChapter = (delta: number) => {
        const activeIndex = chapters.findIndex((chapter) =>
          chapter.classList.contains('is-active')
        );
        const nextIndex = (activeIndex + delta + chapters.length) % chapters.length;
        setChapter(chapters[nextIndex]?.dataset.readerChapter || '');
      };

      document.querySelector('[data-reader-prev]')?.addEventListener('click', () => stepChapter(-1));
      document.querySelector('[data-reader-next]')?.addEventListener('click', () => stepChapter(1));

      let scrollSaveTimer: ReturnType<typeof setTimeout> | undefined;

      reader?.addEventListener('scroll', () => {
        const max = reader.scrollHeight - reader.clientHeight;
        const value = max > 0 ? Math.min(1, Math.max(0, reader.scrollTop / max)) : 0;
        if (progress) {
          progress.style.transform = `scaleX(${value})`;
        }
        if (value > 0.85) {
          const activeId = chapters.find((chapter) => chapter.classList.contains('is-active'))
            ?.dataset.readerChapter;
          if (activeId) {
            markChapterRead(activeId);
          }
        }
        clearTimeout(scrollSaveTimer);
        scrollSaveTimer = setTimeout(() => saveMemory({ scroll: value }), 400);
      });

      document.querySelector('[data-reader-smaller]')?.addEventListener('click', () => {
        fontScale = Math.max(0.9, fontScale - 0.05);
        shell?.style.setProperty('--reader-scale', String(fontScale));
      });

      document.querySelector('[data-reader-larger]')?.addEventListener('click', () => {
        fontScale = Math.min(1.2, fontScale + 0.05);
        shell?.style.setProperty('--reader-scale', String(fontScale));
      });

      document.querySelector('[data-reader-tone]')?.addEventListener('click', () => {
        shell?.classList.toggle('is-dusk');
      });

      fullscreenButton?.addEventListener('click', () => {
        if (!shell) return;

        setReaderFullscreen(!shell.classList.contains('is-reader-fullscreen'));
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && shell?.classList.contains('is-reader-fullscreen')) {
          setReaderFullscreen(false);
          return;
        }

        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;

        const target = event.target instanceof Element ? event.target : null;
        if (target?.closest('input, select, textarea, [contenteditable="true"]')) return;

        // Only page through chapters while the reader is on screen.
        const rect = shell?.getBoundingClientRect();
        if (!rect || rect.top > window.innerHeight || rect.bottom < 0) return;

        stepChapter(event.key === 'ArrowRight' ? 1 : -1);
      });

      const resumeBanner = document.querySelector<HTMLElement>('[data-reader-resume]');
      const resumeLabel = document.querySelector<HTMLElement>('[data-reader-resume-label]');

      const chapterTitle = (id: string) =>
        chapterSelect?.querySelector(`option[value="${id}"]`)?.textContent?.trim() || id;

      const bootFromHash = () => {
        const match = location.hash.match(/^#reader\/([A-Za-z0-9_-]+)(?:\/(sec-\d+))?$/);

        if (!match) return false;

        setChapter(match[1], { scrollTop: false, updateHash: false });

        const section = match[2] ? document.getElementById(`${match[1]}-${match[2]}`) : null;

        if (reader && section) {
          reader.scrollTop =
            section.getBoundingClientRect().top -
            reader.getBoundingClientRect().top +
            reader.scrollTop -
            16;
        }
        document.getElementById('reader')?.scrollIntoView();
        return true;
      };

      const bootFromMemory = () => {
        const memory = loadMemory();
        const last = memory.lastChapter || '';
        const savedScroll = memory.scroll || 0;
        const isKnown = chapters.some((chapter) => chapter.dataset.readerChapter === last);
        const isFreshStart = last === chapters[0]?.dataset.readerChapter && savedScroll < 0.02;

        if (!isKnown || isFreshStart || !resumeBanner || !resumeLabel) return;

        resumeLabel.textContent = chapterTitle(last);
        resumeBanner.hidden = false;

        document.querySelector('[data-reader-resume-go]')?.addEventListener('click', () => {
          setChapter(last, { scrollTop: false });
          if (reader) {
            reader.scrollTop = savedScroll * (reader.scrollHeight - reader.clientHeight);
          }
          resumeBanner.hidden = true;
        });
        document.querySelector('[data-reader-resume-dismiss]')?.addEventListener('click', () => {
          resumeBanner.hidden = true;
        });
      };

      readChapters.forEach((id) => {
        buttons.forEach((button) => {
          if (button.dataset.chapterTarget === id) {
            button.classList.add('is-read');
          }
        });
      });

      if (!bootFromHash()) {
        bootFromMemory();
      }
    };

    const initFlourishes = () => {
      document.documentElement.classList.add('has-flourishes');

      document.querySelectorAll<HTMLImageElement>('.chapter-image img').forEach((img) => {
        if (img.complete) {
          img.classList.add('is-loaded');
          return;
        }
        const markLoaded = () => img.classList.add('is-loaded');
        img.addEventListener('load', markLoaded, { once: true });
        img.addEventListener('error', markLoaded, { once: true });
      });

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const revealTargets = document.querySelectorAll<HTMLElement>(
        '.section__head, .research-card, .hardware-card, .craft-source, .guild-hall, .nostr-columns > *, .contact-grid > *'
      );
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              observer.unobserve(entry.target);
              entry.target.classList.add('is-revealed');
            }
          });
        },
        { threshold: 0.12 }
      );
      revealTargets.forEach((el, index) => {
        el.classList.add('reveal');
        el.style.setProperty('--reveal-delay', `${(index % 4) * 70}ms`);
        observer.observe(el);
      });
    };

    initReader();
    initFlourishes();
  </script>
</Base>
