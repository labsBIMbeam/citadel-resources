---
import { CONTACT } from '../data/resources';
---

<section class="contact-band" id="contact">
  <div class="container contact-grid">
    <div>
      <p class="eyebrow">Contribute</p>
      <h2>Send sources, chapter notes, or guild leads.</h2>
      <p>
        The site stays static and auditable. Send source material by mail or Telegram while the
        public relay workflow is being prepared.
      </p>
    </div>
    <div class="contact-actions" aria-label="Contact links">
      <a class="button button--primary" href={`mailto:${CONTACT.email}`}>Mail</a>
      <a class="button" href={CONTACT.telegram} target="_blank" rel="noopener noreferrer">Telegram</a>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="container">
    <p>
      Citadel Resources | FOSS | no trackers |
      <a href={CONTACT.sister.url} target="_blank" rel="noopener noreferrer">{CONTACT.sister.name}</a>
      |
      <a href={CONTACT.sister2.url} target="_blank" rel="noopener noreferrer">{CONTACT.sister2.name}</a>
    </p>
  </div>
</footer>
