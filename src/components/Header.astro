---
const nav = [
  { href: '#reader', label: 'Reader' },
  { href: '#research', label: 'Research' },
  { href: '#hardware', label: 'Hardware' },
  { href: '#craft', label: 'Craft' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="container header-grid">
    <a href="/" class="brand" aria-label="Citadel Resources home">
      <span class="brand__sigil" aria-hidden="true">C</span>
      <span class="brand__text">
        <strong>Citadel Resources</strong>
        <small>sovereign builder guild</small>
      </span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav-list">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>
